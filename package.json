{
  "name": "model-sync",
  "version": "0.1.0",
  "private": true,
  "description": "AI training orchestrator — diagnose runs, document fixes, keep history",
  "scripts": {
    "dev": "pnpm --filter @model-sync/web dev",
    "dev:web": "pnpm --filter @model-sync/web dev",
    "dev:desktop": "pnpm --filter @model-sync/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0"
}
